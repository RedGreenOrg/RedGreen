# Copy to .env.local for `npm run dev` or set in the Vercel dashboard.
# Public (anon) credentials are safe to expose in a Next.js app when
# Row Level Security is enabled (see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
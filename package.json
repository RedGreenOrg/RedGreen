{
  "name": "redgreen",
  "version": "0.1.1",
  "description": "Reclaim your coding flow state with Type-First Ping-Pong TDD",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "tdd",
    "cli",
    "ai",
    "typescript",
    "pair-programming",
    "test-driven-development",
    "vitest",
    "jest",
    "mocha",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedGreenOrg/RedGreen.git"
  },
  "bin": {
    "redgreen": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@inkjs/ui": "^2.0.0",
    "ai": "^7.0.66",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "ink": "^5.2.0",
    "ink-select-input": "^6.2.0",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
